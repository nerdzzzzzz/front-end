{
  "expo": {
    "name": "nerdz-app",
    "slug": "nerdz-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nerdz-logo.png",
    "scheme": "nerdzapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "output": "static",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nerdz.nerdz",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.nerdz.nerdz",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "display": "standalone",
      "backgroundColor": "#ffffff",
      "description": "App de competição de estudos",
      "themeColor": "#000000",
      "meta": {
        "apple": {
          "mobileWebAppCapable": "yes"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nerdz-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
